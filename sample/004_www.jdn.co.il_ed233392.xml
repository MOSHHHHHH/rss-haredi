		<dc:creator><![CDATA[דודי גרליץ]]></dc:creator>
		<pubDate>Sun, 08 Nov 2026 15:32:49 +0000</pubDate>
				<category><![CDATA[בטחוני]]></category>
		<category><![CDATA[חדשות]]></category>
