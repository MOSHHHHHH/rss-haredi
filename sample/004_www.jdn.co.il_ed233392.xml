			class="jdn-vp jdn-vp--file"
			style=""
			data-jdn-vp="{&quot;kind&quot;:&quot;file&quot;,&quot;autoplay&quot;:false,&quot;loop&quot;:false,&quot;splashend&quot;:false,&quot;live&quot;:false,&quot;start&quot;:0,&quot;end&quot;:0,&quot;volume&quot;:null,&quot;playlistAdvance&quot;:true,&quot;items&quot;:[{&quot;src&quot;:&quot;https://www.jdn.co.il/wp-content/uploads/2026/11/OC6XlJWnOPJEfj63.mp4&quot;,&quot;src1&quot;:&quot;&quot;,&quot;src2&quot;:&quot;&quot;,&quot;mobile&quot;:&quot;&quot;,&quot;splash&quot;:&quot;https://www.jdn.co.il/wp-content/uploads/2026/11/jdn-poster-20261125-083402.jpg&quot;,&quot;splashMode&quot;:&quot;manual&quot;,&quot;title&quot;:&quot;זירת התרסקות המסוק הטורקי. פרסום לפי סעיף 27 א&#039; לחוק זכויות יוצרים&quot;,&quot;subtitles&quot;:&quot;&quot;,&quot;kind&quot;:&quot;file&quot;}],&quot;splashAt&quot;:1,&quot;logo&quot;:{&quot;url&quot;:&quot;https://www.jdn.co.il/wp-content/uploads/2023/06/logosite.png&quot;,&quot;link&quot;:&quot;https://www.jdn.co.il&quot;,&quot;position&quot;:&quot;top-start&quot;},&quot;ads&quot;:{&quot;preroll&quot;:18,&quot;midroll&quot;:0,&quot;endroll&quot;:0,&quot;midrollAt&quot;:30,&quot;skipAfter&quot;:5,&quot;maxSeconds&quot;:20}}"
		>
